{
  "expo": {
    "name": "DropDay",
    "slug": "fgum9ff0goqjv4vh7u4xf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-fgum9ff0goqjv4vh7u4xf",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.fgum9ff0goqjv4vh7u4xf",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "DropDay uses your camera to capture tonight's drop — no uploads from your library.",
        "NSMicrophoneUsageDescription": "DropDay records audio with your video drops.",
        "NSPhotoLibraryUsageDescription": "DropDay needs access to your photo library so you can import media for your drops.",
        "NSPhotoLibraryAddUsageDescription": "DropDay saves your recorded drops to your photo library."
      },
      "usesAppleSignIn": true,
      "buildNumber": "9"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "package": "app.rork.fgum9ff0goqjv4vh7u4xf",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "DropDay needs access to your photos so you can pick a drop.",
          "cameraPermission": "DropDay uses your camera so you can capture tonight's drop."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DropDay uses your camera so you can capture tonight's drop.",
          "microphonePermission": "DropDay records audio with your video drops."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "DropDay saves your drops to your photo library.",
          "savePhotosPermission": "DropDay saves your recorded drops to your photo library."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A84FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://rork.com/"
      },
      "eas": {
        "projectId": "dd7875e4-d7a1-46bf-a2be-4351576c3585"
      }
    },
    "owner": "brendanbjhvh"
  }
}
